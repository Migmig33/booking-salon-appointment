# Safe default: renders queued emails in Edge Function logs and sends nothing.
EMAIL_MODE=log
PUBLIC_SITE_URL=https://your-customer-site.example

# Required only for EMAIL_MODE=test or EMAIL_MODE=production.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=TJ Hair Salon <appointments@your-verified-domain.example>

# In test mode every message is redirected here, regardless of customer email.
EMAIL_TEST_RECIPIENT=developer@example.com
