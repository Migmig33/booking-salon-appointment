# Safe default: renders queued emails in Edge Function logs and sends nothing.
EMAIL_MODE=log
PUBLIC_SITE_URL=https://your-customer-site.example
BUSINESS_NAME=Studio Demo Salon
BUSINESS_ADDRESS=Metro Manila, Philippines
BUSINESS_CONTACT_EMAIL=studio-demo@example.com
BUSINESS_DIRECTIONS_URL=https://maps.google.com/?q=Metro+Manila,+Philippines
BUSINESS_TIME_ZONE=Asia/Manila
BUSINESS_TIME_ZONE_LABEL=Philippine Time (Asia/Manila)
BUSINESS_LOCALE=en-PH
BUSINESS_DEMO_NOTICE=Live Demo — Sample business information
BUSINESS_CANCELLATION_POLICY=Appointments may only be cancelled at least 24 hours before the scheduled start time.

# Free Brevo setup. EMAIL_FROM_ADDRESS must be a sender verified in Brevo.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-replace-me
EMAIL_FROM_NAME=Studio Demo Salon
EMAIL_FROM_ADDRESS=your-verified-sender@gmail.com

# In test mode every message is redirected here, regardless of customer email.
EMAIL_TEST_RECIPIENT=developer@example.com

# Optional Resend alternative:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_replace_me
# EMAIL_FROM=Studio Demo Salon <appointments@your-verified-domain.example>
